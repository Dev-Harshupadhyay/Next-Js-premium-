# ---- Telegram (server-side only, browser me kabhi expose nahi hota) ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# ---- Admin panel ----
ADMIN_PASSWORD=change-me-to-something-strong
# openssl rand -base64 48   se generate karo
ADMIN_JWT_SECRET=please-generate-a-long-random-secret-at-least-32-chars

# ---- Public site config (optional overrides) ----
NEXT_PUBLIC_SITE_URL=https://verceel-timepass.vercel.app

# ---- Database: Upstash Redis (permanent storage) ----
# Ye 2 daalte hi orders/visitors permanently save hone lagenge.
# Na daalo to app local file / memory pe chalega (dev ke liye theek).
# Upstash console -> Database -> REST API se copy karo.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Vercel KV use kar rahe ho to KV_REST_API_URL / KV_REST_API_TOKEN
# bhi automatically detect ho jate hain — kuch change nahi karna.
